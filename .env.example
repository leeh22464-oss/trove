# 复制为 .env 或直接设置为系统环境变量。环境变量优先于设置页里保存的值。
# 注意：服务不会自动读取 .env 文件，请用 `node --env-file=.env src/server.js` 或在 shell 里 export。

# 监听地址与端口（默认仅本机）
HOST=127.0.0.1
PORT=5173

# 数据目录（数据库与图片），默认 ./data
CATCH_DATA_DIR=

# OpenAI 兼容接口的 API Key（base_url 与 model 在设置页填写）
CATCH_LLM_API_KEY=

# 百度 AI Studio 的 Access Token（PaddleOCR 托管 API）
CATCH_PADDLE_TOKEN=
